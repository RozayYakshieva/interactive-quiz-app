# Copy to .env (or export these as OS environment variables) before running the backend.
# Spring Boot reads them via ${VAR} placeholders in application.yml.

DB_URL=jdbc:postgresql://localhost:5432/quiz_app
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Must be a long random string (at least 32 characters for HS256)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION=86400000
